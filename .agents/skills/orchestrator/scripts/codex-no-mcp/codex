#!/usr/bin/env bash
# codex: runs the next `codex` in PATH without the user's MCP servers and connectors, Codex's web tool
# and image generation.
#
# The Codex companion starts `codex app-server` from PATH, so its workers get this wrapper with
# `env -u CODEX_NO_MCP_ARGS PATH="<this folder>:$PATH"` in front of `node … codex-companion.mjs`. It
# runs the real codex with a list's arguments (the -c pairs that turn them off) before the
# companion's own. The list is no-mcp.args beside this file, or the file CODEX_NO_MCP_ARGS names: a
# task's edited copy that gives a server or the web back, set on that one command line as an absolute path.
# A list holds `-c` lines, each followed by its value line (one argument per line; a trailing CR is
# dropped, empty lines are skipped). A list that can't be read, is empty, holds any other line or is
# named by a relative path, or no other codex in PATH, exits 127 and runs nothing.
# PATH is searched in order for an absolute folder holding an executable `codex` that is not this
# file. Entries that are empty or relative (which the shell reads as the current folder or below it)
# are skipped, so a `codex` in a checkout is never run in place of the real one.

die() { printf 'codex-no-mcp: %s\n' "$1" >&2; exit 127; }

# mise's codex wrapper runs the next codex in PATH, which can be this file again, in the same
# process: that second pass adds nothing, as the list is already in "$@".
args=()
if [ "${CODEX_NO_MCP_PID:-}" != "$$" ]; then
  list=${CODEX_NO_MCP_ARGS:-$(dirname -- "$(realpath -- "$0")")/no-mcp.args}
  [[ $list == /* ]] || die "CODEX_NO_MCP_ARGS must be an absolute path: $list"
  [ -f "$list" ] && [ -r "$list" ] || die "cannot read the list $list"
  n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%$'\r'}
    [ -n "$line" ] || continue
    if [ $((${#args[@]} % 2)) = 0 ]; then
      [ "$line" = -c ] || die "$list line $n: expected -c, found: $line"
    else
      [[ $line == *=* && $line != -* ]] || die "$list line $n: expected a key=value after -c, found: $line"
    fi
    args+=("$line")
  done < "$list"
  [ "${#args[@]}" -gt 0 ] || die "the list $list is empty"
  [ $((${#args[@]} % 2)) = 0 ] || die "$list ends with -c and no value"
  export CODEX_NO_MCP_PID=$$
fi

# The first codex in PATH that is not this file, called by the path found: mise's wrapper tells
# which tool to run from the name it was called by.
real=""
IFS=: read -r -a dirs <<< "$PATH"
for dir in "${dirs[@]}"; do
  [[ $dir == /* ]] || continue
  candidate=$dir/codex
  [ -f "$candidate" ] && [ -x "$candidate" ] || continue
  [ "$candidate" -ef "$0" ] && continue
  real=$candidate
  break
done
[ -n "$real" ] || die "no codex in PATH other than this wrapper"
exec "$real" "${args[@]}" "$@"
